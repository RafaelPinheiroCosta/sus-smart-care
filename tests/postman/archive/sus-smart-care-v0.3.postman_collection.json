{
  "info": {
    "name": "SUS Smart Care v0.3 - Core Flows",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "facilityId",
      "value": "11111111-1111-1111-1111-111111111111"
    }
  ],
  "item": [
    {
      "name": "Create patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"fullName\":\"Paciente Demo\",\"birthDate\":\"1985-05-10\",\"identifierType\":\"CPF\",\"identifierValue\":\"00000000191\"}"
        },
        "url": {
          "raw": "{{gateway}}/api/v1/patients",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "patients"
          ]
        }
      }
    },
    {
      "name": "Create pre-visit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"patientId\":\"{{patientId}}\",\"facilityId\":\"{{facilityId}}\",\"channel\":\"MOBILE\"}"
        },
        "url": {
          "raw": "{{gateway}}/api/v1/pre-visits",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "pre-visits"
          ]
        }
      }
    },
    {
      "name": "Start triage",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"visitId\":\"{{visitId}}\"}"
        },
        "url": {
          "raw": "{{gateway}}/api/v1/triages",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "triages"
          ]
        }
      }
    },
    {
      "name": "Enter queue",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"visitId\":\"{{visitId}}\",\"facilityId\":\"{{facilityId}}\",\"clinicalPriority\":\"MEDIUM\"}"
        },
        "url": {
          "raw": "{{gateway}}/api/v1/queue-entries",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "api",
            "v1",
            "queue-entries"
          ]
        }
      }
    }
  ]
}
